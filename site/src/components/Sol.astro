---
/**
 * Chat da Sol, a assistente virtual (27/09/2026; sem voz e com o roteiro de
 * captura no começo desde 28/09). A interação fica em src/scripts/sol.ts e as
 * regras em src/lib/sol.ts.
 * Começa escondido: sem JavaScript o chat não funciona, então nem aparece
 * (os botões de WhatsApp da página continuam atendendo).
 */
import Icone from './Icone.astro';
import { SOL_URL } from '../lib/sol';
import '../styles/sol.css';

const url = import.meta.env.PUBLIC_SOL_URL || SOL_URL;
---

<div class="sol" data-sol data-sol-url={url} hidden>
  <button class="sol-lancador" type="button" aria-expanded="false" aria-controls="sol-painel" data-sol-lancador>
    <span class="sol-orbe sol-orbe-p" aria-hidden="true"></span>
    <span class="sol-lancador-texto"><b>Fale com a Sol</b><small>assistente virtual</small></span>
    <span class="sr"> (abre o chat)</span>
  </button>

  <section class="sol-painel" id="sol-painel" aria-labelledby="sol-titulo" hidden data-sol-painel>
    <header class="sol-topo">
      <span class="sol-orbe" aria-hidden="true"></span>
      <div class="sol-topo-texto">
        <h2 id="sol-titulo">Sol</h2>
        <p><span class="sol-ponto" aria-hidden="true"></span>Assistente virtual da SC</p>
      </div>
      <button class="sol-icone" type="button" data-sol-fechar aria-label="Fechar o chat" title="Fechar">
        <Icone nome="x" tamanho={22} />
      </button>
    </header>

    <div class="sol-conversa" data-sol-conversa role="log" aria-live="polite" aria-relevant="additions" tabindex="-1"></div>

    <div class="sol-rapidas" data-sol-rapidas></div>

    <!-- Aparece na pergunta do WhatsApp: mandar o número é a autorização para a equipe chamar. -->
    <p class="sol-aviso" data-sol-aviso hidden>
      Ao enviar, você autoriza a SC Soluções a te chamar no WhatsApp sobre este atendimento.
      <a href="/privacidade/" target="_blank" rel="noopener">Política de privacidade</a>
    </p>

    <form class="sol-envio" data-sol-form>
      <label class="sr" for="sol-campo" data-sol-rotulo>Sua mensagem para a Sol</label>
      <textarea id="sol-campo" rows="1" maxlength="600" placeholder="Escreva sua mensagem…" enterkeyhint="send" data-sol-campo></textarea>
      <button class="sol-enviar" type="submit" aria-label="Enviar mensagem" data-sol-enviar>
        <Icone nome="send" tamanho={19} traco={2} />
      </button>
    </form>
    <p class="sol-rodape">
      Você está falando com uma assistente virtual. <a href="/privacidade/" target="_blank" rel="noopener">Privacidade</a>
      · <button type="button" class="sol-link" data-sol-recomecar>Recomeçar conversa</button>
    </p>
  </section>
</div>
