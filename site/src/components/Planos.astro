---
/**
 * Tela 2: planos de locação. Abas e carrossel em src/scripts/planos.ts.
 * Desde 28/09/2026 (noite) os botões de venda abrem a Sol com a escolha já
 * escrita; sem JavaScript, levam à seção de contato (#contato).
 * 17/10/2026: inicial mais enxuta; saíram "Personalize seu sistema" (os recursos extras ficam
 * no configurador) e "Por que locar" (o título da seção já diz o principal).
 * 11/11/2026: o texto da proposta e o botão "Pedir proposta" aparecem uma vez só, abaixo dos painéis, quando
 * uma aba de serviço está aberta (a mensagem do botão acompanha a aba); as condições do contrato viram cinco
 * perguntas curtas, com a lista completa dentro de um <details>.
 */
import Icone from './Icone.astro';
import IconeWhatsapp from './IconeWhatsapp.astro';
import MiniPlanta from './MiniPlanta.astro';
import {
  planos, condicoes, condicoesContrato, contratoSimples, servicosProposta, textoProposta,
  formatarPreco, mostrarPrecos, nomePlano, textoTaxaInstalacao, rotuloTaxa,
  linkWhatsapp, mensagemContratar, precoPorCamera, explicacaoGravador,
} from '../lib/dados';

const preco3 = planos.find((x) => x.cameras === 3)?.preco ?? 0;
const preco4 = planos.find((x) => x.cameras === 4)?.preco ?? 0;
const cameras = (n: number) => `${n} ${n > 1 ? 'câmeras' : 'câmera'}`;
const mensagemProposta = (titulo: string) => `Quero uma proposta de ${titulo.toLowerCase()} para o meu ambiente.`;
---

<section class="secao planos" id="planos" aria-labelledby="planos-titulo">
  <div class="wrap">
    <div class="cabeca-secao" data-revelar>
      <div>
        <p class="sobretitulo">Planos de locação</p>
        <h2 class="titulo-secao" id="planos-titulo">Proteção sem precisar<br /><span class="destaque">comprar os equipamentos.</span></h2>
      </div>
      <p>Você escolhe quantas câmeras. A SC instala, configura o acesso pelo celular e cuida da manutenção durante o contrato.</p>
    </div>

    <div class="guias" role="tablist" aria-label="Tipo de solução">
      <button type="button" role="tab" class="guia" id="guia-cameras" aria-controls="aba-cameras" aria-selected="true">
        <Icone nome="cctv" tamanho={17} /> Câmeras
      </button>
      {
        servicosProposta.map((s) => (
          <button type="button" role="tab" class="guia" id={`guia-${s.id}`} aria-controls={`aba-${s.id}`} aria-selected="false" tabindex="-1">
            <Icone nome={s.icone} tamanho={17} /> {s.nome} <small>Proposta</small>
          </button>
        ))
      }
    </div>

    <div role="tabpanel" id="aba-cameras" aria-labelledby="guia-cameras">
      <div class="planos-trilho" tabindex="-1">
        <div class="planos-grade">
          {
            planos.map((p) => (
              <article class:list={['cartao plano', { 'plano-destaque': p.destaque }]} id={`plano-${p.cameras}`} data-plano={p.cameras} aria-labelledby={`plano-${p.cameras}-titulo`}>
                {p.destaque && (
                  <span class="selo selo-laranja plano-selo"><Icone nome="sparkles" tamanho={13} traco={2} /> {p.destaque}</span>
                )}
                <div class="plano-mapa"><MiniPlanta cameras={p.cameras} destaque={Boolean(p.destaque)} /></div>
                <h3 id={`plano-${p.cameras}-titulo`}>{cameras(p.cameras)}</h3>
                <p class="plano-uso">{p.uso}</p>
                {mostrarPrecos ? (
                  <div class="preco"><small>R$</small><strong>{formatarPreco(p.preco)}</strong><em>/mês</em></div>
                ) : (
                  <div class="preco"><strong class="preco-consulta">Sob consulta</strong></div>
                )}
                {mostrarPrecos && <p class="plano-camera">{p.cameras > 1 ? `R$ ${precoPorCamera(p)} por câmera/mês` : 'Uma câmera, sem complicação'}</p>}
                {mostrarPrecos && p.cameras === 3 && <p class="plano-upsell">Por mais R$ {formatarPreco(preco4 - p.preco)}/mês você leva 4 câmeras.</p>}
                {mostrarPrecos && p.cameras === 4 && <p class="plano-upsell">Só R$ {formatarPreco(p.preco - preco3)} a mais que o plano de 3 câmeras: +1 câmera.</p>}
                <p class="plano-cabo"><Icone nome="cable" tamanho={15} /><span>Instalação: {textoTaxaInstalacao(p)}{mostrarPrecos && ` (${rotuloTaxa})`}<br />até {p.caboMetros} m de cabo</span></p>
                <ul class="plano-lista">
                  <li><Icone nome="check" tamanho={16} traco={2.2} />{cameras(p.cameras)} Full HD (2 MP ou superior)</li>
                  <li><Icone nome="check" tamanho={16} traco={2.2} />Gravação no local por aproximadamente 10 dias</li>
                  <li><Icone nome="check" tamanho={16} traco={2.2} />{p.gravador} e imagens no celular</li>
                  {explicacaoGravador(p) && <li class="plano-gravador"><Icone nome="check" tamanho={16} traco={2.2} />{explicacaoGravador(p)}</li>}
                  <li><Icone nome="check" tamanho={16} traco={2.2} />Suporte e manutenção</li>
                </ul>
                <a class:list={['btn plano-cta', p.destaque ? 'btn-primario' : 'btn-contorno']} href={linkWhatsapp(mensagemContratar(p))} target="_blank" rel="noopener" data-plano-cta={p.cameras}>
                  <IconeWhatsapp tamanho={18} /> Quero este plano<span class="sr"> ({nomePlano(p)}, abre o WhatsApp da equipe)</span>
                </a>
                <a class="plano-simular" href={`/monte-seu-sistema/?cameras=${p.cameras}`}>Ver no configurador <Icone nome="arrow-right" tamanho={14} /></a>
              </article>
            ))
          }
        </div>
      </div>
      <div class="planos-pontos" role="group" aria-label="Escolher plano">
        {planos.map((p) => <button type="button" data-ir-plano={p.cameras} aria-label={`Ver ${nomePlano(p)}`} />)}
      </div>
    </div>

    {
      servicosProposta.map((s) => (
        <div class="painel-servico cartao" role="tabpanel" id={`aba-${s.id}`} aria-labelledby={`guia-${s.id}`} data-proposta-mensagem={mensagemProposta(s.titulo)} hidden>
          <span class="selo selo-ciano"><Icone nome={s.icone} tamanho={14} /> Proposta personalizada</span>
          <h3>{s.titulo}</h3>
          <p>{s.texto}</p>
          <ul>{s.itens.map((i) => <li><Icone nome="check" tamanho={16} traco={2.2} />{i}</li>)}</ul>
          {s.id === 'condominio' && (
            <div class="servico-links">
              <a class="btn btn-contorno" href="/condominio/">Conhecer o Condomínio Evoluído</a>
              <a class="btn btn-contorno" href="/monte-seu-sistema/?ambiente=condominio">Montar a proposta no configurador</a>
            </div>
          )}
        </div>
      ))
    }

    <!-- Uma vez só: aparece quando uma aba de serviço está aberta; a mensagem do botão é a da aba (src/scripts/planos.ts). -->
    <div class="proposta-unica cartao" data-proposta-unica hidden>
      <p>{textoProposta}</p>
      <a class="btn btn-primario" href="#contato" data-sol-abrir data-proposta-botao data-sol-mensagem={mensagemProposta(servicosProposta[0]?.titulo ?? '')}>
        <span class="sol-orbe sol-orbe-p" aria-hidden="true"></span> Pedir proposta<span class="sr"> (abre o chat da Sol)</span>
      </a>
    </div>

    <div class="tudo-claro" data-revelar>
      <h3>Simples de contratar<small>Sem papel e sem burocracia.</small></h3>
      {condicoes.map((c) => <div class="condicao"><Icone nome={c.icone} tamanho={20} /><div><b>{c.titulo}</b><span>{c.texto}</span></div></div>)}
    </div>

    <div class="contrato" id="contrato" data-revelar>
      <div class="contrato-cabeca">
        <h3>Condições do contrato</h3>
        <p>O essencial do que você assina, em cinco perguntas. A lista completa fica logo abaixo.</p>
      </div>
      <div class="contrato-lista">
        {
          contratoSimples.map((q) => (
            <div class="contrato-item">
              <h4 class="contrato-pergunta">{q.pergunta}</h4>
              <p>{q.resposta}</p>
            </div>
          ))
        }
      </div>
      <details class="contrato-completo">
        <summary>Ler todas as condições do contrato<Icone nome="plus" tamanho={18} classe="ic-mais" /></summary>
        <div class="contrato-todas">
          {condicoesContrato.map((c) => <div class="condicao"><Icone nome={c.icone} tamanho={20} /><div><b>{c.titulo}</b><span>{c.texto}</span></div></div>)}
        </div>
      </details>
    </div>
  </div>
</section>
