---
import Icone from './Icone.astro';
import Logo from './Logo.astro';
import { contato, empresa } from '../lib/dados';
import { hrefSecao, secoes, solucoes } from '../lib/site';

interface Props {
  /** false nas outras páginas: os links apontam para as seções da inicial (/#planos). */
  naInicial?: boolean;
}
const { naInicial = true } = Astro.props;
---

<footer class="rodape">
  <div class="wrap rodape-linha">
    <a href={naInicial ? '#inicio' : '/'} class="logo-link" aria-label={naInicial ? 'SC Soluções, voltar ao início' : 'SC Soluções, página inicial'}><Logo grande /></a>
    <p class="rodape-desc">Soluções em<br />Segurança e Tecnologia</p>
    <nav class="rodape-nav" aria-label="Rodapé">
      {[...secoes.slice(1), ...solucoes].map((l) => <a href={hrefSecao(l.href, naInicial)}>{l.rotulo}</a>)}
    </nav>
    <a class="voltar-topo" href={naInicial ? '#inicio' : '#conteudo'}>{naInicial ? 'Voltar ao início' : 'Voltar ao topo'} <Icone nome="arrow-up" tamanho={16} /></a>
  </div>
  <p class="wrap rodape-empresa">
    {empresa.nome} em {empresa.descricao} · CNPJ {empresa.cnpj} · {empresa.cidade} · <a href={`mailto:${contato.email}`}>{contato.email}</a> · <a href="/privacidade/">Política de privacidade</a>
  </p>
  <div class="wrap rodape-base">
    <span>© {new Date().getFullYear()} {empresa.nome} · somoscella.online</span>
    <span>Segurança · Redes · Acesso · Energia</span>
  </div>
</footer>
