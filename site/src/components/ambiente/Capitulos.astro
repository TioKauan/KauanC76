---
/**
 * Capítulos das páginas de Casa, Comércio e Empresa. Todo o texto está aqui no HTML (funciona sem
 * JavaScript); o script (src/scripts/ambiente/pagina.ts) liga cada capítulo à maquete e troca o plano.
 * Textos: dados.ts (paginasAmbiente, planos, servicosProposta, upgrades) e cenarios.ts ("E se…?").
 */
import Icone from '../Icone.astro';
import Ese from '../maquete/Ese.astro';
import { paginasAmbiente, servicosProposta, upgrades, textoProposta, type TextosAmbiente, nomePlano, textoPreco, textoTaxaInstalacao, rotuloTaxa, mostrarPrecos } from '../../lib/dados';
import { MAQUETES, type AmbienteMaquete } from '../../lib/ambientes/maquetes';
import { capitulosDe } from '../../lib/ambientes/capitulos';
import { opcoesDePlano, resumoPlano } from '../../lib/ambientes/plano';
import { avisoCabo } from '../../lib/configurador-logica';
import { rotuloCamera } from '../../lib/maquete/tipos';
import { mensagemQueroPlano } from '../../lib/sol';

interface Props { ambiente: AmbienteMaquete }
const { ambiente } = Astro.props;
const t: TextosAmbiente = paginasAmbiente[ambiente];
const m = MAQUETES[ambiente];
const caps = capitulosDe(ambiente);
const total = caps.filter((c) => c.numero).length;
const numero = (id: string) => caps.find((c) => c.id === id)?.numero;
const servico = (id: string) => servicosProposta.find((s) => s.id === id)!;
const redes = servico('redes');
const alarme = servico('alarme');
const inicial = resumoPlano(ambiente, 4);
const pct = Math.min(100, Math.round((inicial.caboEstimado / inicial.plano.caboMetros) * 100));
const onde = ambiente === 'casa' ? 'a minha casa' : ambiente === 'comercio' ? 'o meu comércio' : 'a minha empresa';
---

<div class="capitulos">
  <article class="capitulo capitulo-abertura" id="abertura" data-capitulo="abertura" aria-labelledby="amb-titulo">
    <div class="capitulo-caixa">
      <p class="sobretitulo">{t.sobre}</p>
      <h1 id="amb-titulo">{t.titulo}</h1>
      <p class="capitulo-lead">{t.lead}</p>
      <div class="capitulo-acoes">
        <a class="btn btn-primario btn-g" href="#plano">Escolher o plano <Icone nome="arrow-down" tamanho={18} traco={2} /></a>
        <button type="button" class="btn btn-contorno btn-g" data-explorar data-so-3d hidden><Icone nome="move" tamanho={18} /> Explorar a maquete</button>
      </div>
      <ul class="sistemas-lista">
        {t.destaques.map((i) => <li><Icone nome="check" tamanho={15} traco={2.4} />{i}</li>)}
      </ul>
    </div>
  </article>

  <article class="capitulo" id="cameras" data-capitulo="cameras" aria-labelledby="cap-cameras">
    <div class="capitulo-caixa">
      <p class="sobretitulo">Câmeras <span class="capitulo-num">{numero('cameras')} de {total}</span></p>
      <h2 id="cap-cameras">{t.cameras.titulo}</h2>
      <p class="capitulo-lead">{t.cameras.texto}</p>
      <div class="lista-cameras" role="group" aria-label="Câmeras da maquete">
        {
          m.cameras.map((c) => (
            <button type="button" class="camera-botao" data-camera={c.id} aria-pressed="false">
              <b>{rotuloCamera(c.id).replace('CAM ', '')}</b> {c.nome}
            </button>
          ))
        }
      </div>
      <div class="aviso-cegos">
        <button type="button" class="interruptor-botao" data-pontos-cegos aria-pressed="true" data-so-3d hidden>
          <span class="interruptor" aria-hidden="true"></span><span class="sr">Mostrar pontos cegos</span>
        </button>
        <p><b>Pontos cegos</b>{paginasAmbiente.pontosCegos}</p>
      </div>
    </div>
  </article>

  <article class="capitulo capitulo-plano" id="plano" data-capitulo="plano" aria-labelledby="cap-plano">
    <div class="capitulo-caixa">
      <p class="sobretitulo">Escolha o plano <span class="capitulo-num">{numero('plano')} de {total}</span></p>
      <h2 id="cap-plano">{t.plano.titulo}</h2>
      <p class="capitulo-lead">{t.plano.texto}</p>
      <div class="plano-escolha" role="group" aria-label="Quantidade de câmeras do plano" data-so-js hidden>
        {
          opcoesDePlano.map((n) => (
            <button type="button" class="plano-opcao" data-plano-opcao={n} aria-pressed={n === 4 ? 'true' : 'false'}>
              <b>{n}</b><span>{n > 1 ? 'câmeras' : 'câmera'}</span>
            </button>
          ))
        }
      </div>
      <div class="plano-cartao" data-plano-cartao aria-live="polite">
        <div class="plano-cartao-topo">
          <div>
            <h3 data-plano-nome>{nomePlano(inicial.plano)}</h3>
            <p class="plano-cartao-uso" data-plano-uso>{inicial.plano.uso}</p>
          </div>
          <p class="plano-cartao-preco" data-plano-preco>{textoPreco(inicial.plano)}</p>
        </div>
        <p class="plano-cartao-taxa"><Icone nome="cable" tamanho={15} /><span data-plano-taxa>Instalação: {textoTaxaInstalacao(inicial.plano)}{mostrarPrecos && ` (${rotuloTaxa})`}</span></p>
        <ol class="plano-cameras" data-plano-cameras>
          {inicial.cameras.map((id, i) => <li><b>{rotuloCamera(id).replace('CAM ', '')}</b>{inicial.nomes[i]}</li>)}
        </ol>
        <div class="cabo-medidor" data-plano-cabo>
          <div class="cabo-linha"><span>Cabo estimado</span><span data-plano-cabo-texto><b>≈ {inicial.caboEstimado} m</b> de {inicial.plano.caboMetros} m inclusos</span></div>
          <div class="cabo-trilho" role="progressbar" aria-label="Cabo estimado em relação ao incluso no plano" aria-valuemin="0" aria-valuemax={inicial.plano.caboMetros} aria-valuenow={Math.min(inicial.caboEstimado, inicial.plano.caboMetros)} data-plano-cabo-barra><i style={`width:${pct}%`}></i></div>
          <small data-plano-cabo-aviso>{avisoCabo(inicial.caboExcedente)}</small>
        </div>
        <ul class="plano-cartao-lista">
          <li><Icone nome="check" tamanho={15} traco={2.2} /><span><span data-plano-gravador>{inicial.plano.gravador}</span>, gravação local ≈ 10 dias</span></li>
          <li><Icone nome="check" tamanho={15} traco={2.2} />Imagens no celular</li>
          <li><Icone nome="check" tamanho={15} traco={2.2} />Revisão semestral e manutenção</li>
        </ul>
        <a class="btn btn-primario btn-g plano-cartao-cta" href="#contato" data-sol-abrir data-sol-plano={4} data-sol-mensagem={mensagemQueroPlano(4)} data-plano-cta>
          <span class="sol-orbe sol-orbe-p" aria-hidden="true"></span> Quero este plano<span class="sr" data-plano-cta-sr> ({nomePlano(inicial.plano)}, abre o chat da Sol)</span>
        </a>
        <div class="plano-cartao-links">
          <a href="/#monte"><Icone nome="mouse-pointer-click" tamanho={15} /> Marcar os pontos no Monte seu sistema</a>
          <a href="/#planos" data-sem-js-planos>Ver todos os planos <Icone nome="arrow-right" tamanho={14} /></a>
        </div>
      </div>
      {
        t.plano.extra && (
          <div class="plano-extra">
            <p>{t.plano.extra}</p>
            <a class="btn btn-contorno" href="#contato" data-sol-abrir data-sol-mensagem={`Quero uma proposta personalizada de câmeras e infraestrutura para ${onde}.`}>
              <span class="sol-orbe sol-orbe-p" aria-hidden="true"></span> Pedir proposta<span class="sr"> (abre o chat da Sol)</span>
            </a>
          </div>
        )
      }
      <p class="plano-upgrades"><b>Sob orçamento:</b> {upgrades.map((u) => u.nome.toLowerCase()).join(', ')}.</p>
    </div>
  </article>

  {
    t.rede && (
      <article class="capitulo" id="rede" data-capitulo="rede" aria-labelledby="cap-rede">
        <div class="capitulo-caixa">
          <p class="sobretitulo">{redes.titulo} <span class="capitulo-num">{numero('rede')} de {total}</span></p>
          <h2 id="cap-rede">{t.rede.titulo}</h2>
          <p class="capitulo-lead">{t.rede.texto}</p>
          <ul class="sistemas-lista">{redes.itens.map((i) => <li><Icone nome="check" tamanho={15} traco={2.4} />{i}</li>)}</ul>
          <div class="capitulo-acoes">
            <a class="btn btn-contorno" href="#contato" data-sol-abrir data-sol-mensagem={`Quero uma proposta de ${redes.titulo.toLowerCase()} para ${onde}.`}>
              <span class="sol-orbe sol-orbe-p" aria-hidden="true"></span> Pedir proposta de rede<span class="sr"> (abre o chat da Sol)</span>
            </a>
          </div>
        </div>
      </article>
    )
  }

  <article class="capitulo" id="ese" data-capitulo="ese" aria-labelledby="cap-ese">
    <div class="capitulo-caixa">
      <p class="sobretitulo">E se…? <span class="capitulo-num">{numero('ese')} de {total}</span></p>
      <h2 id="cap-ese">{t.ese.titulo}</h2>
      <p class="capitulo-lead">{t.ese.texto}</p>
      <Ese ambiente={ambiente} rotulo="cap-ese" nobreak="Nobreak sob orçamento" />
      <p class="capitulo-nota">{paginasAmbiente.celular}</p>
    </div>
  </article>

  <article class="capitulo" id="alarme" data-capitulo="alarme" aria-labelledby="cap-alarme">
    <div class="capitulo-caixa">
      <p class="sobretitulo">{alarme.titulo} <span class="capitulo-num">{numero('alarme')} de {total}</span></p>
      <h2 id="cap-alarme">Alarme integrado às câmeras, no celular.</h2>
      <p class="capitulo-lead">{t.alarme.texto}</p>
      <ul class="sistemas-lista">{alarme.itens.map((i) => <li><Icone nome="check" tamanho={15} traco={2.4} />{i}</li>)}</ul>
      <div class="capitulo-acoes">
        <a class="btn btn-contorno" href="#contato" data-sol-abrir data-sol-mensagem={`Quero uma proposta de ${alarme.titulo.toLowerCase()} para ${onde}.`}>
          <span class="sol-orbe sol-orbe-p" aria-hidden="true"></span> Pedir proposta de alarme<span class="sr"> (abre o chat da Sol)</span>
        </a>
      </div>
      <p class="capitulo-nota">{textoProposta}</p>
    </div>
  </article>
</div>
